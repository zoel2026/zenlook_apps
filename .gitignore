# ============================================================
# Environment / secrets — never commit real keys
# ============================================================
.env
.env.*
!.env.example

# ============================================================
# General / OS
# ============================================================
.DS_Store
Thumbs.db
Desktop.ini
*.log

# ============================================================
# Flutter / Dart
# ============================================================
.dart_tool/
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
.packages
# Generated doc / API
**/doc/api/
# Symbolication & obfuscation outputs
app.*.symbols
app.*.map.json

# Avoid committing generated Javascript files:
*.dart.js
*.info.json
*.js
*.js_
*.js.deps
*.js.map

# If you're building an application, you may want to check-in your pubspec.lock
pubspec.lock

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# ============================================================================
# IDEs / editors
# ============================================================================
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo

# ============================================================================
# Node (in case any tooling/scripts live alongside)
# ============================================================================
node_modules/