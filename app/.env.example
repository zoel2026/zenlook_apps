# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Map Tiles Configuration (Production)
# JANGAN gunakan OSM public tiles untuk production!
# Pilih salah satu provider:
#
# Perilaku aplikasi (lihat lib/services/tile_source.dart):
#   - MAP_TILE_URL terisi  -> tile memakai provider di bawah + key-nya
#   - MAP_TILE_URL kosong   -> mode debug (flutter run) masih fallback ke tile
#     OSM publik, TETAPI build release (flutter build apk/appbundle) sengaja
#     tidak memakai tile publik: peta tampil tanpa tile + banner peringatan,
#     supaya rilis tidak melanggar kebijakan penggunaan tile OSM.
#     https://operations.osmfoundation.org/policies/tiles

# Option 1: Stadia Maps (Recommended untuk MVP - 200k free requests/bulan)
MAP_TILE_URL=https://tiles.stadiamaps.com/tiles/osm_bright/{z}/{x}/{y}{r}.png
STADIA_API_KEY=your_stadia_api_key_here

# Option 2: Mapbox (50k free requests/bulan)
# MAP_TILE_URL=https://api.mapbox.com/styles/v1/mapbox/streets-v11/tiles/{z}/{x}/{y}
# MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# Option 3: Maptiler (100k free requests/bulan)
# MAP_TILE_URL=https://api.maptiler.com/maps/streets/{z}/{x}/{y}.png
# MAPTILER_API_KEY=your_maptiler_key_here

# Firebase (FCM for push notifications)
# google-services.json harus ada di android/app/ (download dari Firebase Console)
