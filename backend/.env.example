# ============================================================================
# Supabase connection settings
# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored — never commit real keys.
#
# Project ref: ytmkhmsndfwmjlfyxiiw
# Dashboard:  https://supabase.com/dashboard/project/ytmkhmsndfwmjlfyxiiw
# ============================================================================

# Public API URL (not secret)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Public anon key — safe to ship in the Flutter client
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Service role key — SERVER-ONLY, bypasses Row Level Security. NEVER expose.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
